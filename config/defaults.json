    "authorized_on": "2026-11-18",
    "scope": "JARVIS",
    "path": "up.json",
    "reader": "scripts/read_profile.py",
    "candidate_auto_apply": false,
    "cross_project": false,
    "runtime_enforcement": "local-schema-validation-and-instruction-level-confirmation",
    "template": "up.example.json",
    "initialization": "ask-nickname-on-first-use"
  },
  "control_plane_revision": "2026-11-26-default-loop-1",
  "verification_directory": ".local/verification-runs",
  "preflight_review": {
    "enabled": true,
    "authorized_on": "2026-11-19",
    "scope": "substantive-tasks",
    "requires_complexity_and_loop_rationale": true,
    "human_review_before_dependent_execution": true,
    "silence_is_approval": false,
    "worker_selection": "separate-benefit-based-decision",
    "enforcement": "instruction-only-not-host-approval",
    "explicit_current_execution_can_satisfy_review": true
  },
  "task_lifecycle": {
    "instructions": "docs/task-lifecycle.md",
    "intent_question": "only-when-ambiguous",
    "persistent_card_when_tracking_or_recovery_needed": true,
    "plan_revision_required": true,
    "purpose_review_required": true,
    "recovery_trigger": "explicit-human-request",
    "reconcile_actual_state_before_resume": true,
    "replay_unknown_side_effects": false,
    "reset_budget_on_resume": false,
    "state_storage": "task-card-and-append-only-key-events",
    "enforcement": "instructions-and-local-files-not-runtime-engine",
    "closure": {
      "trigger": "task-delivery-local-candidates",
      "default_mode": "three-layer-local-awaiting-review",
