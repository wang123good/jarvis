      "vault_writes_require_task_allowlist_approval": true,
      "formal_changes_require_approved_diff": true,
      "skip_when_user_declines_notes": true,
      "skill_decision": "confirmed-user-context-and-reuse-value-not-mandatory-sop",
      "ask_skill_creation": "when-worthwhile",
      "close_chat_automatically": false,
      "note_choices": [
        "skip",
        "local-summary",
        "knowledge-vault"
      ],
      "unanswered_note_choice": "use-local-default-for-new-task-not-review-approval",
      "existing_explicit_task_choice": "reuse-without-reasking",
      "execution_evidence_requires_note_opt_in": false,
      "local_layers": [
        "summary",
        "wiki",
        "archive"
      ],
      "review_template": "templates/task-closure-review.md",
      "manifest_template": "templates/task-closure-manifest.json",
      "validator": "scripts/task_closure.py",
      "business_acceptance_and_note_review_separate": true,
      "note_review_does_not_authorize_vault_write": true,
      "wiki_without_new_knowledge": "record-no-candidate-with-reason",
      "default_note_review": "pending",
      "legacy_task_policy": "honor-existing-contract-no-retroactive-generation"
    },
    "session_binding": {
      "trigger": "explicit-real-new-task-first-card",
      "create_dedicated_thread": true,
      "title": "task-name-and-current-status",
      "project": "same-project-local",
      "reuse_existing_task_thread": true,
      "handoff_template": "templates/task-session-handoff.md",
      "handoff_reception": "resume-existing-task-never-create-again",
      "verify": [
        "thread-id",
        "title",
        "project",
        "receiver-context-readback"
      ],
      "side_panel_visual_verification": "separate-when-available",
      "execution_requires_existing_preflight_review": true,
      "unknown_creation_result": "reconcile-before-any-retry",
      "repair_existing_thread_before_recreate": true,
      "source_thread_auto_archive": false,
      "enforcement": "instruction-and-native-tools-not-background-service",
      "requires_explicit_new_chat_authorization": true,
      "missing_chat_authorization": "record-and-continue-authorized-work-in-current-chat"
    },
    "persistent_card_default": true,
    "complete_loop_default": true,
    "loop_runner_required": false,
    "authorized_execution": "continue-check-repair-without-reasking",
    "default_applies_to": "clear-substantive-execution-intent-and-boundary"
  }
