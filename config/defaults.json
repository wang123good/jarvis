  },
  "knowledge_administrator": {
    "enabled_by_user": true,
    "authorized_on": "2026-11-18",
    "deployment": "on-demand-offline-role",
    "instructions": "agents/knowledge-administrator.md",
    "request_template": "templates/knowledge-run-request.json",
    "run_directory": ".local/knowledge-runs",
    "default_mode": "curate",
    "automatic_trigger": false,
    "requires_selected_sources": true,
    "formal_changes_require_approved_diff": true,
    "fork_full_context": false,
    "max_sessions": 1,
    "max_new_semantic_drafts": 3,
    "checkpoint_minutes": 20,
    "max_additional_retries_same_failure": 1,
    "may_spawn_children": false,
    "max_concurrent_writers": 1,
    "concurrency_enforcement": "instruction-only-no-system-lock",
    "close_after_handoff": true,
    "task_closure_trigger": "task-delivery-local-candidates-formal-write-separate-approval"
  },
  "never_infer": [
    "hard-cost-enforcement",
    "worker-access-isolation",
    "cross-session-learning-success"
