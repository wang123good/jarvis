{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JARVIS profile and candidate documents",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "project",
    "version",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "enum": [
        "profile",
        "candidates"
      ]
    },
    "project": {
      "const": "JARVIS"
    },
    "version": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "statement",
          "scope",
          "evidence_kind",
          "status",
          "conditions",
          "exceptions",
          "approved_at",
          "approved_by",
          "last_verified_at",
          "review_after",
          "supersedes",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "enum": [
              "communication",
              "execution",
              "delivery",
              "governance",
              "background"
            ]
          },
          "statement": {
            "type": "string"
          },
          "scope": {
            "const": "JARVIS"
          },
          "evidence_kind": {
            "enum": [
              "reviewed_agreement",
              "explicit_user_statement",
              "observation"
            ]
          },
          "status": {
            "enum": [
              "candidate",
              "approved",
              "suspended",
              "revoked",
              "superseded",
              "rejected"
            ]
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exceptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "approved_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "approved_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_verified_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "review_after": {
            "type": [
              "string",
              "null"
            ]
          },
          "supersedes": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": "object",
            "required": [
              "path",
              "anchor",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "anchor": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "approved"
                }
              }
            },
            "then": {
              "properties": {
                "approved_by": {
                  "const": "user"
                },
                "approved_at": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_kind": {
                  "enum": [
                    "reviewed_agreement",
                    "explicit_user_statement"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
